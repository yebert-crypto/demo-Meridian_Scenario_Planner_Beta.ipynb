# Copy to .env and fill in values

# NewsAPI (free tier: 100 req/day — https://newsapi.org)
NEWS_API_KEY=your_key_here

# Proxycurl — LinkedIn GC tracking ($0.10/lookup — https://proxycurl.com)
PROXYCURL_API_KEY=your_key_here

# Pitchbook API (when available)
PITCHBOOK_API_KEY=your_key_here
PITCHBOOK_API_URL=https://api.pitchbook.com/v1

# Alert email (optional)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@perkinscoie.com
SMTP_PASS=your_password

# Slack webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
